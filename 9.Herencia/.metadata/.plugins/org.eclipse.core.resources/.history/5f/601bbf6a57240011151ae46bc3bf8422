package Ejemplo2;

public class Extranjero extends Alumno{
	private String origen;
	public Extranjero(String nombre, String apellidos, String curso, double importeMatricula,String origen) {
		super(nombre, apellidos, curso, importeMatricula);
		// TODO Auto-generated constructor stub
		this.importeMatricula= importeMatricula + importeMatricula * 15 / 100;
		this.origen = origen;
	}
	@Override
	public String toString() {
		return "Extranjero Nombre:"+" "+super.toString()+","+origen;
	}
}
