package Ejemplo1;

public class LibroTexto extends Libro{
	private String curso;
	 private double descuento;
	 public LibroTexto(String titulo, String autor, String editorial, double precio, String curso, double descuento) {
		super(titulo, autor, editorial, precio);
		this.curso = curso;
		this.descuento = descuento;
	 }
	 @Override
	 public String toString() {
		return "LibroTexto [curso=" + curso + ", descuento=" + descuento + super.toString();
	 }
}
